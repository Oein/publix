# Copy to docker-compose.override.yml to add anything of your own.
#
# This file is yours: it is gitignored and never touched by an upgrade,
# which is exactly why it exists. The tracked docker-compose.yml is
# replaced wholesale when publix updates itself, so an edit made there
# would be lost — along with, typically, the volume mounts your projects
# depend on.
#
# scripts/install.sh includes it automatically when it is present. Running
# compose by hand, pass both files:
#
#   docker compose -f deploy/docker-compose.yml \
#                  -f deploy/docker-compose.override.yml up -d

services:
  publix:
    volumes:
      # One line per volume you register in the dashboard, each at the SAME
      # path on both sides. publix hands paths to the Docker daemon, which
      # resolves them on the host — so a path that means one thing inside
      # the container and another outside produces projects bind-mounting
      # the wrong directory.
      - /mnt/data:/mnt/data
      - /mnt/media:/mnt/media
      - /srv/uploads:/srv/uploads

  # Traefik rarely needs anything, but the same rule applies if it does.
  # traefik:
  #   volumes:
  #     - /etc/ssl/private:/etc/ssl/private:ro

  # A raw TCP entry point, for a project with a `tcp:` route that names an
  # `entryPoint` — git over SSH being the usual reason.
  #
  # publix writes Traefik's *dynamic* configuration, never its static
  # configuration, so the entry point itself has to be declared here and the
  # port published. The name must match the one in deployment.yaml, and the
  # entry point must be dedicated: everything arriving on it is forwarded to
  # that one project, because a protocol that is not TLS offers nothing to
  # tell connections apart by.
  #
  # traefik:
  #   command:
  #     # Compose replaces the whole command list rather than appending to
  #     # it, so copy every flag from deploy/docker-compose.yml and add
  #     # yours at the end. Leaving one out silently disables it.
  #     - --providers.docker=true
  #     - --providers.docker.exposedByDefault=false
  #     - --providers.docker.network=publix
  #     - --providers.file.directory=/etc/traefik/dynamic
  #     - --providers.file.watch=true
  #     - --entrypoints.web.address=:80
  #     - --entrypoints.web.http.redirections.entrypoint.to=websecure
  #     - --entrypoints.web.http.redirections.entrypoint.scheme=https
  #     - --entrypoints.websecure.address=:443
  #     - --certificatesresolvers.letsencrypt.acme.email=${ACME_EMAIL}
  #     - --certificatesresolvers.letsencrypt.acme.storage=/acme/acme.json
  #     - --certificatesresolvers.letsencrypt.acme.httpchallenge=true
  #     - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web
  #     - --log.level=INFO
  #     - --entrypoints.gitssh.address=:2222
  #   ports:
  #     - "80:80"
  #     - "443:443"
  #     - "2222:2222"
