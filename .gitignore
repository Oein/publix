# Build output
/publix
/dist/
/bin/

# The dashboard is built into internal/api/dist for embedding.
/internal/api/dist/*
!/internal/api/dist/.gitkeep

# Node
node_modules/
/web/dist/
*.tsbuildinfo

# Local state
.publix/
*.local.yaml

# Written by scripts/install.sh; holds the operator's ACME email.
/deploy/.env

# The operator's own compose additions. Tracked docker-compose.yml is
# replaced on every upgrade, so anything local has to live outside it.
/deploy/docker-compose.override.yml
